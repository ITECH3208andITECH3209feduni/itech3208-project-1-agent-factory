<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts Agent Factory at login on the Mac mini (docs/MAC_MINI.md step 6).
     Replace both REPLACE_ME paths with the absolute path of your checkout. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentfactory.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_ME/scripts/serve_up.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_ME</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/Applications/Docker.app/Contents/Resources/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/agentfactory-serve.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/agentfactory-serve.log</string>
</dict>
</plist>
