# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Required ───────────────────────────────────────────────────
# Claude API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Literature search ────────────────────────────────
# Semantic Scholar API key — raises rate limit from 1 req/s to 100 req/s
# Get a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ── Optional: Agent behaviour ──────────────────────────────────
# MAX_RESULTS=10        # max items returned per skill call
# REQUEST_TIMEOUT=15    # HTTP request timeout in seconds
# MAX_RETRIES=3         # retry attempts on network failure
