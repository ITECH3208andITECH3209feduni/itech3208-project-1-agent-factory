# Agent Factory — environment template
#
# Copy to .env and fill in your values:
#     cp .env.example .env
#     chmod 600 .env
#
# .env is gitignored and must never be committed. config/settings.py loads it
# with override=True, so values here beat anything already exported in your
# shell — edit the file, not your shell profile.
#
# Check your setup at any time:
#     python -c "from config.settings import validate_env; print(*validate_env(), sep='\n')"

# ══════════════════════════════════════════════════════════════
# REQUIRED
# ══════════════════════════════════════════════════════════════

# Claude API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...


# ══════════════════════════════════════════════════════════════
# LITERATURE SEARCH
# ══════════════════════════════════════════════════════════════

# Semantic Scholar API key — raises the limit to 100 requests / 5 minutes.
# Register at https://www.semanticscholar.org/product/api-key
# (SEMANTIC_SCHOLAR_API_KEY is still accepted as a legacy alias.)
S2_API_KEY=

# Client-side token bucket guarding the S2 quota. Defaults: 100 requests per
# 300s with a key, 20 per 300s without. Only override if S2 changes your tier.
# S2_RATE_LIMIT_REQUESTS=100
# S2_RATE_LIMIT_PERIOD=300
# S2_RATE_LIMIT_TIMEOUT=60


# ══════════════════════════════════════════════════════════════
# TELEGRAM  (Sprint 3)
# ══════════════════════════════════════════════════════════════

# Bot token from @BotFather — /newbot, then copy the token it gives you.
# Format: 123456789:AAExampleTokenStringFromBotFather
BOT_TOKEN=


# ══════════════════════════════════════════════════════════════
# GOOGLE CALENDAR  (Sprint 3)
# ══════════════════════════════════════════════════════════════

# PATH to the OAuth client secrets JSON, not the JSON itself. Download from
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Desktop app). Keep the file outside the repo, or in a gitignored dir.
GOOGLE_CALENDAR_CREDENTIALS=

# Where the OAuth token is cached after you complete the consent flow.
# GOOGLE_CALENDAR_TOKEN_PATH=store/google_calendar_token.json


# ══════════════════════════════════════════════════════════════
# CHROMADB  (Sprint 3)
# ══════════════════════════════════════════════════════════════

# On-disk vector store. Defaults to store/chromadb inside the project.
# Under Docker Compose this is set to a mounted volume instead.
CHROMADB_PATH=store/chromadb
# CHROMADB_COLLECTION=agent_factory


# ══════════════════════════════════════════════════════════════
# WEB API AUTH  (Sprint 3)
# ══════════════════════════════════════════════════════════════

# Signing secret for session tokens. Generate a fresh one per environment:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# An empty secret means every token validates — never expose the API without it.
JWT_SECRET=
# JWT_ALGORITHM=HS256
# JWT_TTL_SEC=86400


# ══════════════════════════════════════════════════════════════
# AGENT BEHAVIOUR  (optional)
# ══════════════════════════════════════════════════════════════

# MAX_RESULTS=10        # max items returned per skill call
# REQUEST_TIMEOUT=15    # HTTP request timeout in seconds
# MAX_RETRIES=3         # retry attempts on network failure
