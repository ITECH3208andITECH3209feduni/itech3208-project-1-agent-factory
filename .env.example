# Copy this file to .env and fill in your values
# Never commit .env to git

# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot token (required if using Telegram channel)
TELEGRAM_BOT_TOKEN=

# OneCLI gateway (optional — manages credential injection into agent containers)
ONECLI_URL=
ONECLI_API_KEY=

# Google Calendar (optional — required for appointment booking)
# Service account JSON key path, relative to the project root. Keep the key
# file itself out of git (see .gitignore's secrets/ entry).
GOOGLE_CALENDAR_KEY_PATH=secrets/calendar-key.json
GOOGLE_CALENDAR_ID=

# Twilio (optional — required for outbound SMS/voice reminders, PROJ-396,
# and for the inbound AI Receptionist webhooks in app/web_ui/twilio_routes.py).
# ACCOUNT_SID/AUTH_TOKEN are real secrets — get them from console.twilio.com,
# never commit them. FROM_NUMBER is the number already purchased for this
# project's live demos: +1 802 444 8729 (E.164 format below).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+18024448729

# SMTP (optional — required for outbound email reminders, PROJ-396)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
